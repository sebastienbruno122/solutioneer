---
import CategoryTag from './CategoryTag.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  href: string;
  title: string;
  description: string;
  pillarCode: string;
  pillarLabel: string;
  date: Date;
  readingMinutes: number;
  compact?: boolean;
}

const { lang, href, title, description, pillarCode, pillarLabel, date, readingMinutes, compact = false } =
  Astro.props;
const t = useTranslations(lang);

const formattedDate = date.toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

{compact ? (
  <article
    data-reveal
    class="group rounded-lg border border-hairline bg-canvas p-4 transition-colors duration-150 hover:border-accent-300"
  >
    <a href={href} class="block">
      <CategoryTag code={pillarCode} label={pillarLabel} size="sm" />
      <h3 class="mt-2 text-[15px] font-semibold leading-snug text-ink transition-colors duration-150 group-hover:text-accent-600">
        {title}
      </h3>
      <div class="mt-2 flex items-center gap-2 font-mono text-[11px] text-ink-soft">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes} {t('meta.readingTime')}</span>
      </div>
    </a>
  </article>
) : (
  <article
    data-reveal
    class="group flex h-full flex-col rounded-lg border border-hairline bg-canvas p-5 transition-all duration-150 hover:border-accent-300 hover:shadow-[0_1px_0_0_rgba(30,79,216,0.06),0_8px_20px_-10px_rgba(16,21,31,0.12)]"
  >
    <a href={href} class="flex h-full flex-col">
      <CategoryTag code={pillarCode} label={pillarLabel} size="sm" />
      <h3 class="mt-3 text-lg font-semibold leading-snug text-ink transition-colors duration-150 group-hover:text-accent-600">
        {title}
      </h3>
      <p class="mt-2 line-clamp-2 text-[15px] leading-relaxed text-ink-soft">{description}</p>
      <div class="mt-4 flex items-center gap-2 font-mono text-[11px] text-ink-soft">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes} {t('meta.readingTime')}</span>
      </div>
    </a>
  </article>
)}
