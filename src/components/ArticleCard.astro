---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  href: string;
  title: string;
  description: string;
  pillarLabel: string;
  date: Date;
  readingMinutes: number;
}

const { lang, href, title, description, pillarLabel, date, readingMinutes } = Astro.props;
const t = useTranslations(lang);

const formattedDate = date.toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article data-reveal class="group border-b border-hairline py-6 first:pt-0 last:border-none">
  <a href={href} class="block">
    <div class="mb-2 flex items-center gap-2 text-xs font-medium text-accent-600">
      <span>{pillarLabel}</span>
    </div>
    <h3 class="text-lg font-semibold leading-snug text-ink transition-colors duration-150 group-hover:text-accent-600">
      {title}
    </h3>
    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink-soft">{description}</p>
    <div class="mt-3 flex items-center gap-2 text-xs text-ink-soft">
      <time datetime={date.toISOString()}>{formattedDate}</time>
      <span aria-hidden="true">·</span>
      <span>{readingMinutes} {t('meta.readingTime')}</span>
    </div>
  </a>
</article>
