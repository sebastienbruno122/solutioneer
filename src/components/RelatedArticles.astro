---
import ArticleCard from './ArticleCard.astro';
import { useTranslations, pillarMeta, type Lang } from '../i18n/ui';
import { articlePath } from '../i18n/paths';
import { slugOf, readingTime, type Article } from '../lib/articles';

interface Props {
  lang: Lang;
  articles: Article[];
}

const { lang, articles } = Astro.props;
const t = useTranslations(lang);

if (articles.length === 0) return null;
---

<section class="mt-16 border-t border-hairline pt-10" aria-labelledby="related-heading">
  <h2 id="related-heading" class="text-xl font-semibold text-ink">{t('article.relatedTitle')}</h2>
  <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
    {articles.map((article) => (
      <ArticleCard
        compact
        lang={lang}
        href={articlePath(lang, slugOf(article))}
        title={article.data.title}
        description={article.data.description}
        pillarCode={pillarMeta[lang][article.data.pillar].code}
        pillarLabel={pillarMeta[lang][article.data.pillar].label}
        date={article.data.pubDate}
        readingMinutes={readingTime(article.body ?? '')}
      />
    ))}
  </div>
</section>
