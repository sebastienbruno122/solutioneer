---
interface Props {
  href: string;
  index: number;
  label: string;
  tagline: string;
}

const { href, index, label, tagline } = Astro.props;
---

<a
  href={href}
  data-reveal
  class="group block rounded-xl border border-hairline bg-canvas p-6 transition-all duration-200 hover:border-accent-300 hover:shadow-[0_1px_0_0_rgba(30,79,216,0.06),0_8px_24px_-12px_rgba(16,21,31,0.12)]"
>
  <span class="font-mono text-xs font-medium text-accent-600">0{index}</span>
  <h3 class="mt-3 text-xl font-semibold text-ink">{label}</h3>
  <p class="mt-2 text-sm leading-relaxed text-ink-soft">{tagline}</p>
  <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-ink transition-colors duration-150 group-hover:text-accent-600">
    <span aria-hidden="true">→</span>
  </span>
</a>
