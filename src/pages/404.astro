---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="fr"
  title="404 — Page introuvable"
  description="Cette page n'existe pas ou plus."
  path="/404/"
  noindex
>
  <div class="mx-auto flex max-w-xl flex-col items-center px-5 py-28 text-center sm:px-8">
    <p class="text-xs font-semibold uppercase tracking-wide text-accent-600">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">
      Page introuvable · Page not found
    </h1>
    <p class="mt-4 text-base leading-relaxed text-ink-soft">
      Cette page n'existe pas ou plus, ou le lien est incorrect.
      <br />
      This page doesn't exist or has moved, or the link is incorrect.
    </p>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/fr/"
        class="rounded-md bg-accent-500 px-5 py-2.5 text-sm font-semibold text-white transition-colors duration-150 hover:bg-accent-600"
      >
        Accueil (Français)
      </a>
      <a
        href="/en/"
        class="rounded-md border border-hairline px-5 py-2.5 text-sm font-semibold text-ink transition-colors duration-150 hover:border-accent-300"
      >
        Home (English)
      </a>
    </div>
    <div class="mt-4 flex flex-wrap items-center justify-center gap-4 text-sm">
      <a href="/fr/blog/" class="text-ink-soft hover:text-ink">Voir le blog</a>
      <a href="/en/blog/" class="text-ink-soft hover:text-ink">Browse the blog</a>
    </div>
  </div>
</BaseLayout>
